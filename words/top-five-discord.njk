            <h3 id="h.qqr6l2o49lpm" style="display:inline"><span class="c2 c17">Rocket.Chat &ndash;</span><span
                    class="c17 c25">&nbsp;Open-source platform with powerful customization</span></h3>
        </li>
    </ul>
    <p class="c5 c16"><span class="c1"></span></p>
